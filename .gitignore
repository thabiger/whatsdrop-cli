# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test, lint and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Local configuration and secrets
.env
.env.*
!.env.example
credentials.json
*.key
*.pem
*.token

# Exported media is plaintext and should stay local
whatsdrop-media/
wa-media/
media/
*.part

# OS and editor files
.DS_Store
.idea/
.vscode/
*.log
